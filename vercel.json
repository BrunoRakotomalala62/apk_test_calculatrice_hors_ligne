{
  "version": 2,
  "name": "calculatrice-pwa",
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/sw.js",
      "headers": {
        "Cache-Control": "no-cache",
        "Service-Worker-Allowed": "/"
      },
      "dest": "/sw.js"
    },
    {
      "src": "/manifest.webmanifest",
      "headers": {
        "Content-Type": "application/manifest+json"
      },
      "dest": "/manifest.webmanifest"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
